<Window x:Class="CargoLoad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Раскладка грузов" Height="860" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource InputFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InputFg}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="InputCb" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource InputFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False" />
                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                      Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункты выпадающих списков: цвета берутся из темы, контраст высокий -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Вкладки: без системного светлого хрома -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="Transparent"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="0,0,0,-1" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="5" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Border}" CornerRadius="5" Margin="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Header}" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Header}" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Margin="20,16,20,8">
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource Btn}"
                    Content="Тема: тёмная" Click="ThemeButton_Click" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Раскладка грузов" Foreground="{DynamicResource Text}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Автоматизация загрузки транспортных средств"
                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="MainTab" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,0,12,10">

            <!-- ============ ТС ============ -->
            <TabItem Header="  Транспортные средства  ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Справочник ТС"
                                       Foreground="{DynamicResource Text}" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ListView x:Name="VehicleTable" Background="Transparent" BorderThickness="0"
                                      SelectionChanged="VehicleTable_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Название" Width="180"
                                                        DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Д×Ш×В, м" Width="200"
                                                        DisplayMemberBinding="{Binding DimsText}" />
                                        <GridViewColumn Header="Тоннаж, т" Width="120"
                                                        DisplayMemberBinding="{Binding PayloadText}" />
                                        <GridViewColumn Header="Погрузка" Width="140"
                                                        DisplayMemberBinding="{Binding LoadText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Параметры ТС" Foreground="{DynamicResource Text}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Название" />
                            <TextBox x:Name="VName" Style="{StaticResource Input}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Длина, м" />
                            <TextBox x:Name="VLen" Style="{StaticResource Input}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Ширина, м" />
                            <TextBox x:Name="VWid" Style="{StaticResource Input}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Высота, м" />
                            <TextBox x:Name="VHei" Style="{StaticResource Input}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Грузоподъёмность, т" />
                            <TextBox x:Name="VPayload" Style="{StaticResource Input}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Lbl}" Text="Способ погрузки" />
                            <ComboBox x:Name="VLoad" Style="{StaticResource InputCb}" Margin="0,0,0,16">
                                <ComboBoxItem Content="зад / бок" Tag="3" />
                                <ComboBoxItem Content="бок / верх" Tag="6" />
                                <ComboBoxItem Content="верх" Tag="4" />
                                <ComboBoxItem Content="зад" Tag="1" />
                                <ComboBoxItem Content="бок" Tag="2" />
                            </ComboBox>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnAccent}" Content="Добавить"
                                        Click="BtnVehAdd_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Btn}" Content="Сохранить"
                                        Click="BtnVehSave_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Btn}" Content="Удалить"
                                        Click="BtnVehDelete_Click" />
                            </StackPanel>
                            <TextBlock x:Name="VehStatus" Foreground="{DynamicResource Muted}"
                                       FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Задания ============ -->
            <TabItem Header="  Задания на погрузку  ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Задание:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
                        <ComboBox x:Name="ShipmentCombo" DockPanel.Dock="Left" Width="340"
                                  VerticalAlignment="Center" Style="{StaticResource InputCb}"
                                  SelectionChanged="ShipmentCombo_SelectionChanged" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Удалить задание"
                                Click="BtnDeleteShipment_Click" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Импорт Excel/CSV"
                                Click="BtnImport_Click" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnAccent}" Content="Новое задание"
                                Click="BtnNewShipment_Click" />
                    </DockPanel>

                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource Border}"
                              RowBackground="{DynamicResource Panel}"
                              AlternatingRowBackground="{DynamicResource PanelAlt}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Border}"
                              HeadersVisibility="Column" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ типа" Binding="{Binding TypeNo}" Width="70" />
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="90" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70" />
                            <DataGridTextColumn Header="Д, мм" Binding="{Binding LengthMm}" Width="75" />
                            <DataGridTextColumn Header="Ш, мм" Binding="{Binding WidthMm}" Width="75" />
                            <DataGridTextColumn Header="В, мм" Binding="{Binding HeightMm}" Width="75" />
                            <DataGridTextColumn Header="Вес ед., кг" Binding="{Binding UnitWeight}" Width="95" />
                            <DataGridTextColumn Header="Вес всего, кг" Binding="{Binding TotalWeight}" Width="105" />
                            <DataGridTextColumn Header="Штаб." Binding="{Binding StackableText}" Width="65" />
                            <DataGridTextColumn Header="Кант." Binding="{Binding RotateText}" Width="65" />
                            <DataGridTextColumn Header="Макс. нагр., кг" Binding="{Binding MaxLoadText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Добавить груз вручную" Foreground="{DynamicResource Text}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MName" Grid.Column="0" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="Груз" />
                                <TextBox x:Name="MQty" Grid.Column="1" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="1" />
                                <TextBox x:Name="ML" Grid.Column="2" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="1200" />
                                <TextBox x:Name="MW" Grid.Column="3" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="800" />
                                <TextBox x:Name="MH" Grid.Column="4" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="1000" />
                                <TextBox x:Name="MWeight" Grid.Column="5" Style="{StaticResource Input}"
                                         Margin="0,0,6,0" Text="100" />
                                <Button Grid.Column="6" Style="{StaticResource BtnAccent}" Content="Добавить"
                                        Click="BtnAddItem_Click" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"
                                       Text="название · кол-во · длина(мм) · ширина(мм) · высота(мм) · вес единицы(кг)" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Раскладка ============ -->
            <TabItem Header="  Раскладка  ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Задание:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                        <ComboBox x:Name="PackShipmentCombo" DockPanel.Dock="Left" Width="240"
                                  VerticalAlignment="Center" Style="{StaticResource InputCb}" />
                        <TextBlock DockPanel.Dock="Left" Text="Режим:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Margin="14,0,8,0" />
                        <ComboBox x:Name="PackModeSelect" DockPanel.Dock="Left" Width="170"
                                  VerticalAlignment="Center" Style="{StaticResource InputCb}"
                                  SelectedIndex="0" SelectionChanged="PackModeSelect_SelectionChanged">
                            <ComboBoxItem Content="Вручную" />
                            <ComboBoxItem Content="Автоматический" />
                        </ComboBox>
                        <TextBlock DockPanel.Dock="Left" Text="Ориентация:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Margin="14,0,8,0" />
                        <ComboBox x:Name="PackRotCombo" DockPanel.Dock="Left" Width="210"
                                  VerticalAlignment="Center" Style="{StaticResource InputCb}" SelectedIndex="0">
                            <ComboBoxItem Content="Длинной стороной вдоль" />
                            <ComboBoxItem Content="+ поворот на 90°" />
                            <ComboBoxItem Content="Свободная (кантование)" />
                        </ComboBox>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnAccent}" Content="Рассчитать"
                                Click="BtnPack_Click" Padding="22,8" />
                    </DockPanel>

                    <!-- Ручной выбор машин -->
                    <Border x:Name="ManualPanel" Grid.Row="1" Style="{StaticResource Card}"
                            Margin="0,0,0,10" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Машины:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                <ComboBox x:Name="TruckTypeCombo" Width="260" Style="{StaticResource InputCb}" />
                                <TextBlock Text="Кол-во:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="12,0,8,0" />
                                <TextBox x:Name="TruckQty" Width="60" Style="{StaticResource Input}" Text="1" />
                                <Button Style="{StaticResource Btn}" Content="Добавить" Margin="10,0,0,0"
                                        Click="BtnAddTruck_Click" />
                                <Button Style="{StaticResource Btn}" Content="Убрать" Margin="8,0,0,0"
                                        Click="BtnRemoveTruck_Click" />
                            </StackPanel>
                            <ListView x:Name="TruckList" Height="86" Margin="0,10,0,0"
                                      Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}"
                                      BorderThickness="1" Foreground="{DynamicResource Text}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SummaryText" Grid.Row="2" Foreground="{DynamicResource Text}"
                               FontSize="13" TextWrapping="Wrap" Margin="2,0,0,10" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Машины"
                                           Foreground="{DynamicResource Text}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox x:Name="MachineList" Background="Transparent" BorderThickness="0"
                                         SelectionChanged="MachineList_SelectionChanged" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="CanvasTitle" Text="Вид сверху"
                                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,6" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="PackCanvas" Background="{DynamicResource Canvas}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Отчёт" Foreground="{DynamicResource Text}" FontSize="14"
                                               FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ReportText" Foreground="{DynamicResource Text}"
                                               FontSize="12.5" TextWrapping="Wrap" LineHeight="21" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Не размещено" Foreground="{DynamicResource Text}"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="UnplacedText" Foreground="{DynamicResource Danger}"
                                               FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Легенда" Foreground="{DynamicResource Text}"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel x:Name="LegendPanel" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>